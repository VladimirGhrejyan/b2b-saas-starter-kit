{
  "name": "@b2b-saas-starter-kit/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "nx": {
    "name": "desktop",
    "tags": [
      "scope:frontend",
      "type:app"
    ],
    "implicitDependencies": [
      "web"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsc --build tsconfig.app.json",
          "cwd": "apps/desktop"
        }
      },
      "serve": {
        "continuous": true,
        "dependsOn": [
          "build",
          {
            "projects": [
              "web"
            ],
            "target": "build"
          }
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "electron .",
          "cwd": "apps/desktop"
        }
      }
    }
  },
  "dependencies": {
    "electron": "^44.0.0"
  }
}
