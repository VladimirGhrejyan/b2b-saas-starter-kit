# Copy to infra/env/.env (gitignored) and adjust. Placeholders only —
# never commit real secrets. The root `infra:*` scripts read this via --env-file.

# --- Compose ---------------------------------------------------------------
# Stable prefix for container / volume / network names.
COMPOSE_PROJECT_NAME=b2b-saas-starter-kit

# --- Node ------------------------------------------------------------------
# Keep in sync with .nvmrc and package.json "engines" (enforced by
# `pnpm check:node-version`). Used as a build arg by future app images.
NODE_VERSION=24.19.0

# --- Application -----------------------------------------------------------
NODE_ENV=development
# Which app a container/process is (api | worker | web | admin).
APP_TYPE=api
PORT=3000

# --- PostgreSQL (container) ------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=app
# Host port published in local dev only (docker-compose.override.yml).
# If a native Postgres already uses 5432, pick a free port and update DATABASE_URL to match.
POSTGRES_PORT=5432

# --- Redis (container) -----------------------------------------------------
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# --- Connection strings (env-driven config contract) -----------------------
# Same variables everywhere; only the host changes:
#   local dev (apps on host) -> localhost (ports published by the override)
#   Compose / staging        -> service names: postgres / redis
#   future GCP               -> managed hostnames (Cloud SQL / Memorystore)
DATABASE_URL=postgres://app:change-me-local-only@localhost:5432/app
REDIS_URL=redis://localhost:6379

# --- Outbound HTTP (optional; defaults apply when unset) -------------------
# HTTP_CLIENT_TIMEOUT_MS=10000
# HTTP_CLIENT_CONNECT_TIMEOUT_MS=5000
# HTTP_CLIENT_POOL_MAX=16
# HTTP_CLIENT_MAX_RESPONSE_BYTES=2097152
# HTTP_CLIENT_USER_AGENT=b2b-saas-http-client
# HTTP_CLIENT_MAX_REDIRECTS=3
# HTTPS_PROXY=
# NO_PROXY=

# --- API auth (Phase 20) ----------------------------------------------------
# Short-lived HS256 access JWT. Production must set a non-default secret.
# JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me
# JWT_ACCESS_TTL_SECONDS=900
# JWT_ISSUER=b2b-saas-starter-kit
# JWT_AUDIENCE=b2b-saas-api
# Web (`http://localhost:4200`) sends the refresh cookie cross-origin.
# CORS_ORIGINS=http://localhost:4200
# CORS_CREDENTIALS=true

# --- SMTP (optional; unset keeps LoggingMailer) -----------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# SMTP_SECURE=false
