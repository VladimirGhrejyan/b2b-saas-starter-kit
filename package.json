{
  "name": "@b2b-saas-starter-kit/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "git:validate-branch": "pnpm exec jiti scripts/git/validate-branch.ts",
    "check:node-version": "pnpm exec jiti scripts/node/check-node-version.ts",
    "infra:up": "docker compose --project-directory . --env-file infra/env/.env -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.override.yml up -d",
    "infra:down": "docker compose --project-directory . --env-file infra/env/.env -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.override.yml down",
    "infra:reset": "docker compose --project-directory . --env-file infra/env/.env -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.override.yml down --volumes && docker compose --project-directory . --env-file infra/env/.env -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.override.yml up -d",
    "infra:logs": "docker compose --project-directory . --env-file infra/env/.env -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.override.yml logs -f",
    "dev:api": "pnpm nx serve api",
    "dev:worker": "pnpm nx serve worker",
    "dev:web": "pnpm nx serve web",
    "dev:admin": "pnpm nx serve admin",
    "build": "pnpm nx run-many -t build -p api,worker,web,admin",
    "typecheck": "pnpm nx run-many -t typecheck",
    "test": "pnpm nx run-many -t test",
    "test:eslint-plugin": "pnpm exec vitest run --config vitest.eslint-plugin.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/format": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "^23.1.1",
    "@nx/eslint-plugin": "^23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "^23.1.1",
    "@nx/node": "23.1.1",
    "@nx/react": "^23.1.1",
    "@nx/vite": "^23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/rule-tester": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.3.0",
    "nx": "23.1.1",
    "prettier": "~3.6.2",
    "swc-loader": "^0.2.7",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.11",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
