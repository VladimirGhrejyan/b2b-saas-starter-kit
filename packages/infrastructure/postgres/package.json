{
  "name": "@b2b-saas-starter-kit/postgres",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "postgres",
    "tags": [
      "scope:backend",
      "layer:infrastructure"
    ],
    "targets": {
      "migration:create": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec node --import @swc-node/register/esm-register src/kernel/migration-cli/create.ts",
          "cwd": "{projectRoot}",
          "env": {
            "SWC_NODE_PROJECT": "tsconfig.lib.json"
          }
        }
      },
      "migration:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec node --import @swc-node/register/esm-register src/kernel/migration-cli/generate.ts",
          "cwd": "{projectRoot}",
          "env": {
            "SWC_NODE_PROJECT": "tsconfig.lib.json"
          }
        }
      },
      "migration:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec node --import @swc-node/register/esm-register src/kernel/migration-cli/run.ts",
          "cwd": "{projectRoot}",
          "env": {
            "SWC_NODE_PROJECT": "tsconfig.lib.json"
          }
        }
      },
      "migration:revert": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec node --import @swc-node/register/esm-register src/kernel/migration-cli/revert.ts",
          "cwd": "{projectRoot}",
          "env": {
            "SWC_NODE_PROJECT": "tsconfig.lib.json"
          }
        }
      }
    }
  },
  "dependencies": {
    "@b2b-saas-starter-kit/application": "workspace:*",
    "@b2b-saas-starter-kit/config": "workspace:*",
    "@b2b-saas-starter-kit/domain": "workspace:*",
    "@b2b-saas-starter-kit/platform": "workspace:*",
    "@b2b-saas-starter-kit/shared-kernel-types": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@b2b-saas-starter-kit/node": "workspace:*",
    "@b2b-saas-starter-kit/security": "workspace:*",
    "@nestjs/testing": "^12.0.1",
    "@swc-node/register": "^1.12.1",
    "@types/pg": "^8.23.1"
  }
}
